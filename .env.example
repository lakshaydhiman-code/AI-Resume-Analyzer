# Database Configuration (PostgreSQL default, falls back to SQLite automatically if Postgres is unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

# JWT Security
SECRET_KEY=resumelab-super-secret-jwt-signing-key-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Path to Tesseract OCR executable (if not in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
